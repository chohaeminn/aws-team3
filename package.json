{
  "name": "refund-tracker",
  "version": "0.1.0",
  "description": "AWS 3조 — 결제 취소·환불 추적 서비스",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23 || >=24"
  },
  "scripts": {
    "build": "vite build",
    "start": "npm run build && tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:dynamodb": "tsx scripts/test-dynamodb.ts",
    "benchmark:reliability": "tsx scripts/benchmark-reliability.ts after",
    "benchmark:access": "tsx scripts/benchmark-access.ts after"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1178.0",
    "@aws-sdk/client-dynamodb": "^3.1178.0",
    "@aws-sdk/lib-dynamodb": "^3.1178.0",
    "aws-jwt-verify": "^5.2.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
