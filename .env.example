# Google Gemini 무료 API 키(https://aistudio.google.com/apikey). 값을 채워 .env로 복사해 사용합니다.
# 서버 시작 시 .env를 자동으로 읽습니다. .env는 Git에 올리지 않습니다.
GEMINI_API_KEY=
AI_PROVIDER=gemini
# AWS에서는 AI_PROVIDER=bedrock으로 변경. AWS 자격 증명은 프로필/인스턴스 역할로 제공.
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# 선택: 사용할 모델(기본 gemini-3.5-flash-lite). 404가 나면 https://aistudio.google.com/docs/models 에서 사용 가능한 모델을 확인합니다.
GEMINI_MODEL=
# 선택: thinking 예산(기본 0=끔). 모델이 이 설정을 거부해 400이 나면 none 으로 설정하면 요청에서 제외됩니다.
GEMINI_THINKING_BUDGET=

HOST=127.0.0.1
PORT=3000
# 증빙·멱등성 결과·감사 기록 영속 저장. :memory:는 재시작 시 초기화.
PAYMENT_DB_PATH=data/payments.sqlite
# Cognito 설정이 없으면 업무 API는 401로 차단됩니다. 액세스 키·JWT·비밀번호는 여기에 넣지 않습니다.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
